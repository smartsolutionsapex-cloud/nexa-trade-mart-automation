{
  "name": "nexa-trade-mart-automation",
  "version": "1.0.0",
  "description": "Complete end-to-end automation system for NEXA TRADE MART e-commerce business",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "frontend:dev": "cd frontend && npm start",
    "dashboard:dev": "cd dashboard && npm start",
    "test": "jest",
    "build": "npm run build:backend && npm run build:frontend && npm run build:dashboard",
    "build:backend": "echo 'Backend build complete'",
    "build:frontend": "cd frontend && npm run build",
    "build:dashboard": "cd dashboard && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "deploy": "npm run build && docker-compose up -d",
    "stop": "docker-compose down"
  },
  "keywords": [
    "ecommerce",
    "automation",
    "firebase",
    "whatsapp",
    "n8n",
    "business-automation"
  ],
  "author": "Smart Solutions Apex Cloud",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "firebase": "^10.0.0",
    "firebase-admin": "^12.0.0",
    "axios": "^1.4.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express-validator": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "twilio": "^4.0.0",
    "node-cron": "^3.0.3",
    "mongoose": "^7.5.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3"
  }
}
